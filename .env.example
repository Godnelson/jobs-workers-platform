# API
APP_ENV=dev
APP_LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8080

# Postgres
POSTGRES_USER=jobs
POSTGRES_PASSWORD=jobs
POSTGRES_DB=jobs
DATABASE_URL=postgresql+asyncpg://jobs:jobs@postgres:5432/jobs

# Redis
REDIS_URL=redis://redis:6379/0
RQ_QUEUE_NAME=default

# Optional: OpenTelemetry (no exporter configured by default)
OTEL_SERVICE_NAME=jobs-workers
OTEL_TRACES_EXPORTER=none
OTEL_METRICS_EXPORTER=none
